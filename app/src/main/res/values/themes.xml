<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EasyGPG" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink_deep</item>
        <item name="colorOnPrimary">@color/paper</item>

        <!-- Brass is used as a fill. colorOnSecondary is dark because white on brass is 2.42:1. -->
        <item name="colorSecondary">@color/brass</item>
        <!-- The variant is the text-safe brass, for accents drawn on light surfaces. -->
        <item name="colorSecondaryVariant">@color/brass_deep</item>
        <item name="colorOnSecondary">@color/ink_on_brass</item>

        <item name="android:statusBarColor">@color/ink_deep</item>
    </style>

    <style name="Theme.EasyGPG.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.EasyGPG.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.EasyGPG.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
